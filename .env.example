OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
WHISPER_MODEL=base
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
ACCESS_CODES={"viewer":"viewer_demo_code","editor":"editor_demo_code","admin":"admin_demo_code"}
# Alternative formats: ROLE_ACCESS_CODES=viewer:viewer_demo_code,editor:editor_demo_code,admin:admin_demo_code
# Legacy ACCESS_CODE is only used as an admin code when no role-based code is configured.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=3600
MAX_AUDIO_UPLOAD_MB=25
MAX_DOCUMENT_UPLOAD_MB=10
MAX_SUMMARY_DOCUMENTS=5
CHROMA_URL=http://localhost:9001
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION=office_agent_documents
CHROMA_TIMEOUT_SECONDS=15
CHROMA_TOKEN=
